# =============================================================================
# GATE CSE Intelligence - what must NEVER go into git
# =============================================================================

# ---- Secrets: API keys, passwords (copy .env.example -> .env locally) -------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- Local databases: your reviews live here, keep them on this machine -----
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.pgdump
*.dump

# ---- Backups and archives (DB snapshots, old ZIP packages) ------------------
backups/
*.zip
*.7z
*.tar
*.tar.gz
*.rar

# ---- Source PDFs and generated data (large / rebuildable) -------------------
data/raw/*
!data/raw/.gitkeep
data/extracted/
data/assets/
quickstart-out/

# ---- Exports: regenerated by `python -m src.cli export` ---------------------
exports/*
!exports/ai_review/
exports/ai_review/*
!exports/ai_review/*.decisions.json
!exports/ai_review/make_benchmark_decisions.py

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Test / tool caches ------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.streamlit/secrets.toml

# ---- Logs and temp files -----------------------------------------------------
*.log
*.tmp
*.bak
~$*

# ---- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Personal agent settings (local permissions) ----------------------------
.claude/settings.local.json
